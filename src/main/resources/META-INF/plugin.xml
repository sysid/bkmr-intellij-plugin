<!-- File: src/main/resources/META-INF/plugin.xml -->
<!-- version, idea-version and change-notes are injected at build time by patchPluginXml (build.gradle.kts) -->
<idea-plugin>
    <id>com.sysid.bkmr</id>
    <name>bkmr</name>
    <vendor url="https://github.com/sysid/bkmr">sysid</vendor>

    <description><![CDATA[
        Integration with the bkmr snippet manager via LSP.

        <p><b>Features:</b></p>
        <ul>
            <li>Automatic snippet completion in the completion popup while typing (powered by the bkmr LSP server)</li>
            <li>Snippet placeholder navigation with Tab/Shift+Tab</li>
            <li>Insert filepath comment action (comment syntax detected from file type)</li>
            <li>Configurable bkmr binary path</li>
        </ul>

        <p><b>Usage:</b></p>
        <ul>
            <li>Snippets appear automatically in the completion popup while typing</li>
            <li>Use Ctrl+Space for manual completion</li>
            <li>Run "Bkmr: Insert Filepath Comment" via Find Action or the editor right-click menu</li>
        </ul>

        <p><b>Requirements:</b></p>
        <ul>
            <li>bkmr command-line tool (v4.24.0+) available in PATH or configured in Settings → Tools → bkmr</li>
        </ul>
    ]]></description>

    <!-- <depends>com.intellij.modules.ultimate</depends> -->

    <extensions defaultExtensionNs="com.intellij">
        <!-- LSP Integration Provider -->
        <platform.lsp.integrationProvider
            implementation="com.sysid.bkmr.BkmrLspIntegrationProvider"/>

        <!-- Settings -->
        <applicationService
            serviceImplementation="com.sysid.bkmr.settings.BkmrSettings"/>

        <!-- Settings UI -->
        <applicationConfigurable
            parentId="tools"
            instance="com.sysid.bkmr.settings.BkmrConfigurable"
            id="com.sysid.bkmr.settings.BkmrConfigurable"
            displayName="bkmr"/>

        <!-- Notification Group -->
        <notificationGroup id="Bkmr Notifications" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Insert Filepath Comment Action -->
        <action id="com.sysid.bkmr.InsertFilepathCommentAction"
                class="com.sysid.bkmr.InsertFilepathCommentAction"
                text="Bkmr: Insert Filepath Comment"
                description="Insert filepath as comment at the beginning of the file">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
